# Asset-only rebuild on top of the last full layered build.
#
# The full frappe_docker layered build needs ~20GB of buildkit cache, and this
# host's root fs runs chronically near 100%. When a change touches only the LMS
# frontend (Vue/CSS), this rebuilds just the assets on top of the existing
# image: same app source as origin/main, a fraction of the disk and time.
#
# Use the full layered Containerfile whenever python/deps/frappe version change.
ARG BASE=ghcr.io/x-project-coding/new-money-university:baf6f6d1
FROM ${BASE}

USER frappe

# Source comes from `git archive origin/main` - never the working tree.
COPY --chown=frappe:frappe frontend /home/frappe/frappe-bench/apps/lms/frontend
COPY --chown=frappe:frappe lms /home/frappe/frappe-bench/apps/lms/lms

# src/socket.js imports socketio_port from sites/common_site_config.json. The
# image ships that file as `{}` (the real one lives in the sites volume at
# runtime), and vite inlines the value at build time - so seed production's port
# for the build, then restore the original. The runtime volume masks it anyway.
RUN set -eux; \
	export PATH="/home/frappe/.nvm/versions/node/v24.12.0/bin:${PATH}"; \
	cd /home/frappe/frappe-bench; \
	mkdir -p sites; \
	cp sites/common_site_config.json /tmp/csc.orig 2>/dev/null || echo '{}' > /tmp/csc.orig; \
	echo '{"socketio_port": 9000}' > sites/common_site_config.json; \
	cd apps/lms/frontend; \
	yarn build; \
	test -f /home/frappe/frappe-bench/apps/lms/lms/public/frontend/index.html; \
	cp /tmp/csc.orig /home/frappe/frappe-bench/sites/common_site_config.json; \
	rm -f /tmp/csc.orig
